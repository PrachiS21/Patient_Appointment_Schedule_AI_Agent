# Copy to .env and fill in. Loaded explicitly by agent/src/patient_intake_agent/llm.py
# (from Mysource/.env, regardless of current working directory).

# Which LLM provider the agent uses (see agent/src/patient_intake_agent/llm.py).
# "bedrock" (default), "anthropic" (Claude API directly, no AWS), "gemini",
# or "ollama" (a local model, free, no API key, no rate limits).
LLM_PROVIDER=ollama

# =============================================================================
# Option A: LLM_PROVIDER=bedrock
# =============================================================================
# AWS credentials, resolved through the standard boto3 credential chain —
# any ONE of the following is enough:

# a named profile from ~/.aws/credentials
# AWS_PROFILE=your-profile-name

# or direct credentials (e.g. CI, or no shared profile configured)
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_SESSION_TOKEN=...   # only if using temporary/STS credentials

# Region Bedrock model access was granted in (see AWS Console > Bedrock > Model access)
# AWS_REGION=us-east-1

# Bedrock model ID. Must be a model your account has Bedrock access to.
# BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-5

# =============================================================================
# Option B: LLM_PROVIDER=anthropic
# =============================================================================
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL_ID=claude-sonnet-5

# =============================================================================
# Option C: LLM_PROVIDER=gemini
# =============================================================================
# GEMINI_API_KEY=your-gemini-api-key-here
# GEMINI_MODEL_ID=gemini-flash-latest

# =============================================================================
# Option D: LLM_PROVIDER=ollama
# =============================================================================
# Requires a local Ollama server running (`ollama serve`) with a model
# pulled that supports tool calling (needed for our structured-output
# pattern) — e.g. `ollama pull llama3.2`.
OLLAMA_MODEL_ID=llama3.2:3b
# OLLAMA_BASE_URL=http://localhost:11434
