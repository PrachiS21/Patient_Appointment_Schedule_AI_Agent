# Copy to .env and fill in. Loaded via python-dotenv by the agent package.
#
# AWS credentials for Bedrock, resolved through the standard boto3 credential
# chain — any ONE of the following is enough:

# Option 1: a named profile from ~/.aws/credentials
# AWS_PROFILE=your-profile-name

# Option 2: direct credentials (e.g. CI, or no shared profile configured)
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_SESSION_TOKEN=...   # only if using temporary/STS credentials

# Region Bedrock model access was granted in (see AWS Console > Bedrock > Model access)
AWS_REGION=us-east-1

# Bedrock model ID used by every LLM-backed node (Intake, Emergency Guard's
# classifier tier, Triage, Scheduling's reconciliation step). Must be a model
# your account has Bedrock access to.
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-5
